It looks like CONFIG_CMA=3Dy && !CONFIG_COMPACTION is at fault here which
would explain why I didn't catch it with my testing because I do not
have CONFIG_CMA on.
Should we just return false unconditionally for !COMPACTION case?
Something like (untested):

diff --git a/include/linux/pageblock-flags.h b/include/linux/pageblock-flag=
s.h
index eed27f4..925f246 100644
--- a/include/linux/pageblock-flags.h
+++ b/include/linux/pageblock-flags.h
@@ -78,6 +78,19 @@ void set_pageblock_flags_group(struct page *page, unsign=
ed long flags,
 #define set_pageblock_skip(page) \
 			set_pageblock_flags_group(page, 1, PB_migrate_skip,  \
 							PB_migrate_skip + 1)
+#else
+static inline bool get_pageblock_skip(struct page *)
+{
+	return false;
+}
+
+static inline bool clear_pageblock_skip(struct page *)
+{
+}
+
+static inline bool set_pageblock_skip(struct page *)
+{
+}
 #endif /* CONFIG_COMPACTION */
=20
 #define get_pageblock_flags(page) \

